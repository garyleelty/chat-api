# Doubao Chat API — example configuration
# Copy to .env and adjust. .env is git-ignored.

# ── API ──
API_V1_PREFIX=/api/v1
PROJECT_NAME=Doubao Chat API
VERSION=1.0.0
DEBUG=false

# ── Server ──
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ── Playwright ──
BROWSER_TYPE=chromium
# Set to false to watch the browser drive the page — the fastest way to debug selectors.
HEADLESS=true
SLOW_MO=0
TIMEOUT=30000

# ── Doubao ──
DOUBAO_URL=https://www.doubao.com/chat/

# ── Logging ──
LOG_LEVEL=INFO
